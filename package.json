{
  "name": "agentsmd-medic",
  "version": "0.1.1",
  "description": "Lint and validate AGENTS.md files — the instructions AI coding agents (Codex, Cursor, Copilot, Jules, ...) read from your repo.",
  "keywords": [
    "agents.md",
    "agents-md",
    "linter",
    "ai",
    "codex",
    "coding-agents",
    "cli",
    "markdown"
  ],
  "license": "MIT",
  "author": "weugit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weugit/agentsmd-medic.git"
  },
  "bugs": {
    "url": "https://github.com/weugit/agentsmd-medic/issues"
  },
  "homepage": "https://github.com/weugit/agentsmd-medic#readme",
  "type": "module",
  "bin": {
    "agentsmd-medic": "bin/agentsmd-medic.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "selfcheck": "npm run build && node bin/agentsmd-medic.js .",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
